# ============================================================
# American Group LLC — americangroup.ai
# Apache .htaccess — HTTPS Enforcement + SPA Routing + Security
# ============================================================

# ── Enable Rewrite Engine ────────────────────────────────────
Options -MultiViews
Options +FollowSymLinks

# Allow all access (required for HostGator shared hosting)
Order allow,deny
Allow from all

RewriteEngine On
RewriteBase /

# ── Force HTTPS (automatic SSL redirect) ────────────────────
# Redirect all HTTP traffic to HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ── Canonical host: www.americangroup.ai ─────────────────────
# The owner named https://www.americangroup.ai/ as the address; the bare
# domain answers 301 to the same path on www. safecodeg.com was retired on
# 2026-10-12 and no longer redirects here (owner's decision).
RewriteCond %{HTTP_HOST} ^americangroup\.ai$ [NC]
RewriteRule ^(.*)$ https://www.americangroup.ai/$1 [L,R=301]

# ── Retired India pages ──────────────────────────────────────
# /scg and /safecodex-research were an India-office page that the owner had
# removed as unrelated to American Group LLC. Old links land on /about.
RewriteRule ^(scg|safecodex-research)/?$ https://www.americangroup.ai/about [NC,L,R=301]

# ── Extensionless static pages ───────────────────────────────
# The policy pages are real files: /policy/iMaps/delete-account.html and so on.
# Without this rule a request for /policy/iMaps/delete-account is neither a file
# nor a directory, so it falls through to the SPA catch-all below and returns
# the site shell with HTTP 200. Google Play read that as the page not existing
# and rejected the Data safety declaration. Serve the matching .html when one
# exists, before the catch-all can claim the request.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.html -f
RewriteRule ^(.+?)/?$ /$1.html [L]

# >>> AGL policy aliases (generated by agl-manifest/scripts/policy_aliases.py)
# Do not edit by hand — re-run the generator.
#
# Every one of these would otherwise hit the SPA catch-all below and
# return the marketing homepage with HTTP 200, which reads as a working
# page to a store reviewer and to any automated checker.

# mod_speling fixes case on its own where it is available. The explicit
# rules after it do the same job on hosts where it is not, and also
# cover the aliases that are not just a case difference. None of them
# carry [NC]: with it, ^policy/imaps/ would also match /policy/iMaps/
# and redirect to itself forever.
<IfModule mod_speling.c>
    CheckSpelling On
    CheckCaseOnly On
</IfModule>

RewriteRule ^policy/AGCleaner/(.*)$ /policy/agcleaner/$1 [R=301,L]
RewriteRule ^policy/AGCleaner/?$ /policy/agcleaner/ [R=301,L]
